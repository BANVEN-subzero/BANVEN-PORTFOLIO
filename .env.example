# ────────────────────────────────────────────────────────────────
# Portfolio environment — copy to .env and fill in what you need.
# The site builds and runs fine with NONE of these set (the contact
# address falls back to src/config/profile.ts → contact.email).
# ────────────────────────────────────────────────────────────────

# 1. Where contact-form messages arrive (destination inbox)
PORTFOLIO_EMAIL=banven100@gmail.com

# 2. Real email delivery — create a free API key at https://resend.com
#    Without it, the form honestly reports "not configured" and offers
#    a pre-filled mailto: fallback instead of faking success.
RESEND_API_KEY=

# 3. Verified "from" address. Leave empty for testing (uses Resend's
#    onboarding@resend.dev, which only delivers to your own account
#    email). For production, verify a domain at resend.com and use:
#    CONTACT_FROM_EMAIL="Portfolio Contact <portfolio@yourdomain.com>"
CONTACT_FROM_EMAIL=

# 4. Canonical public URL of the deployment (used for SEO metadata).
#    e.g. https://banven-portfolio.vercel.app or your custom domain
NEXT_PUBLIC_SITE_URL=

# 5. Optional — GitHub token for the repo feed if you hit rate limits
#    (fine-grained or classic, read-only public access, no scopes needed)
GITHUB_TOKEN=
